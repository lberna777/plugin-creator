      "vintage":     { "aliases": ["vintage", "retro", "anni 70", "anni 60", "old school", "oldschool"], "axes": { "vintage": 0.5, "brightness": -0.2, "character": 0.25 } },
      "moderna":     { "aliases": ["moderna", "moderno", "modern", "attuale", "digitale", "digital"], "axes": { "vintage": -0.4, "brightness": 0.2, "cleanliness": 0.15 } },
      "silenziosa":  { "aliases": ["senza rumore", "no noise", "silenziosa", "rumore di fondo", "ventola", "rumorosa", "noisy"], "axes": { "cleanliness": 0.4 } },
      "desibilata":  { "aliases": ["esse", "sibilanti", "de-esser", "deesser", "sibilance", "lisca"], "axes": { "sibilance_control": 0.35 } }
    },

    "delivery": {
      "rapped":    { "aliases": ["rappata", "rappato", "rap", "rapped", "flow"] },
      "sung":      { "aliases": ["cantata", "cantato", "sung", "melodica", "melodico", "singing"] },
      "screamed":  { "aliases": ["urlata", "urlato", "screamed", "scream", "gridata", "shout"] },
      "whispered": { "aliases": ["sussurrata", "sussurrato", "whispered", "whisper", "soffiata"] },
