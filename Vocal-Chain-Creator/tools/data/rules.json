      "youtube":   { "aliases": ["youtube", "video", "social", "tiktok", "instagram", "reel"], "loudness_target_lufs": -14 },
      "podcast_t": { "aliases": ["per podcast", "podcasting"], "loudness_target_lufs": -16 },
