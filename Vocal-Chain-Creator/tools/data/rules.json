{
  "version": "1.0.0",
  "notes": "TUTTI i numeri del dominio stanno qui. Il codice non contiene valori DSP. Le espressioni sono valutate su un contesto piatto (assi + profilo di sorgente) con funzioni: clamp, min, max, abs, round, lerp, pos, neg.",

  "intent_defaults": {
    "axes": {
      "brightness": 0.0, "weight": 0.0, "aggression": 0.0, "density": 0.35,
      "character": 0.15, "intimacy": 0.0, "cleanliness": 0.45, "vintage": 0.0,
      "sibilance_control": 0.45
    },
    "pitch_class": "mid",
    "delivery": "sung",
    "loudness_target_lufs": -14.0
  },

  "axis_ranges": {
    "brightness": [-1, 1], "weight": [-1, 1], "aggression": [-1, 1], "density": [0, 1],
    "character": [0, 1], "intimacy": [-1, 1], "cleanliness": [0, 1], "vintage": [0, 1],
    "sibilance_control": [0, 1]
  },

  "modifiers": {
    "negation": ["non", "no", "meno", "senza", "not", "less", "without", "nessun", "nessuna", "niente"],
    "intensifier": { "terms": ["molto", "super", "tanto", "parecchio", "troppo", "very", "really", "extremely", "iper", "ultra"], "scale": 1.5 },
    "diminisher": { "terms": ["poco", "leggermente", "un po", "appena", "slightly", "a bit", "lieve"], "scale": 0.5 },
    "window": 3
  },

  "io_defaults": { "declared_latency_ms": 2.0, "true_peak_ceiling_dbfs": -1.0 },

  "pitch_factors": { "low": 0.85, "mid": 1.0, "high": 1.15 },

  "lexicon": {
