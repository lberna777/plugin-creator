      "aggressiva":  { "aliases": ["aggressiva", "aggressivo", "aggressive", "cattiva", "incazzata", "energica", "in faccia"], "axes": { "aggression": 0.4, "density": 0.2, "character": 0.15 } },
      "morbida":     { "aliases": ["morbida", "morbido", "smooth", "dolce", "delicata", "gentile"], "axes": { "aggression": -0.35, "brightness": -0.1, "character": -0.1 } },
      "presente":    { "aliases": ["presente", "avanti", "upfront", "in primo piano", "radiofonica", "radio", "broadcast"], "axes": { "brightness": 0.25, "density": 0.3, "intimacy": 0.2 } },
      "intima":      { "aliases": ["intima", "intimo", "intimate", "vicina", "close", "confidenziale"], "axes": { "intimacy": 0.45, "weight": 0.15, "density": 0.15 } },
      "distante":    { "aliases": ["distante", "distant", "lontana", "far"], "axes": { "intimacy": -0.4 } },
      "compressa":   { "aliases": ["compressa", "compresso", "compressed", "schiacciata", "densa", "controllata", "incollata", "glued"], "axes": { "density": 0.35 } },
      "dinamica":    { "aliases": ["dinamica", "dinamico", "dynamic", "naturale", "aperta", "respirata", "natural"], "axes": { "density": -0.3, "character": -0.1 } },
      "punchy":      { "aliases": ["punchy", "punch", "grintosa", "incisiva"], "axes": { "aggression": 0.25, "density": 0.2 } },
      "pulita":      { "aliases": ["pulita", "pulito", "clean", "trasparente", "transparent", "chirurgica", "precisa"], "axes": { "character": -0.3, "cleanliness": 0.35 } },
      "sporca":      { "aliases": ["sporca", "sporco", "dirty", "grezza", "saturata", "distorta", "gritty"], "axes": { "character": 0.45, "aggression": 0.25 } },
      "nastro":      { "aliases": ["nastro", "tape", "analogica", "analogico", "analog"], "axes": { "character": 0.35, "vintage": 0.45, "brightness": -0.1 } },
