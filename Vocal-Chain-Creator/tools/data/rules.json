      "rap":       { "aliases": ["rap", "hip hop", "hiphop", "hip-hop", "boom bap"], "delivery": "rapped", "axes": { "aggression": 0.35, "density": 0.55, "character": 0.3, "intimacy": 0.2 }, "loudness_target_lufs": -10 },
      "pop":       { "aliases": ["pop", "mainstream"], "axes": { "brightness": 0.35, "density": 0.55, "character": 0.25, "cleanliness": 0.2 }, "loudness_target_lufs": -11 },
      "rnb":       { "aliases": ["rnb", "r&b", "soul", "neo soul"], "axes": { "weight": 0.25, "density": 0.45, "character": 0.35, "intimacy": 0.35, "brightness": 0.1 }, "loudness_target_lufs": -12 },
      "rock":      { "aliases": ["rock", "punk", "grunge"], "axes": { "aggression": 0.45, "character": 0.5, "density": 0.4, "brightness": 0.15 }, "loudness_target_lufs": -10 },
      "metal":     { "aliases": ["metal", "hardcore", "screamo"], "delivery": "screamed", "axes": { "aggression": 0.7, "character": 0.55, "density": 0.6, "sibilance_control": 0.2 }, "loudness_target_lufs": -9 },
      "indie":     { "aliases": ["indie", "lo-fi", "lofi", "bedroom"], "axes": { "character": 0.45, "vintage": 0.4, "brightness": -0.15, "density": 0.3 }, "loudness_target_lufs": -13 },
      "cantautore":{ "aliases": ["cantautore", "folk", "acustico", "singer songwriter", "songwriter"], "axes": { "intimacy": 0.4, "density": 0.25, "character": 0.15, "cleanliness": 0.15 }, "loudness_target_lufs": -14 },
      "jazz":      { "aliases": ["jazz", "crooner", "swing"], "axes": { "weight": 0.3, "vintage": 0.5, "density": 0.2, "brightness": -0.1, "character": 0.25 }, "loudness_target_lufs": -16 },
      "edm":       { "aliases": ["edm", "dance", "house", "techno"], "axes": { "brightness": 0.45, "density": 0.65, "character": 0.3, "aggression": 0.2 }, "loudness_target_lufs": -9 },
      "podcast":   { "aliases": ["podcast", "intervista", "talk"], "delivery": "spoken", "axes": { "density": 0.6, "cleanliness": 0.55, "brightness": 0.15, "character": -0.05, "intimacy": 0.25 }, "loudness_target_lufs": -16 },
      "voiceover": { "aliases": ["voiceover", "speakeraggio", "narrazione", "audiolibro", "audiobook", "vo"], "delivery": "spoken", "axes": { "density": 0.55, "cleanliness": 0.6, "weight": 0.2, "brightness": 0.1 }, "loudness_target_lufs": -18 }
    },

    "descriptors": {
      "caldo":       { "aliases": ["caldo", "calda", "warm", "corposa", "corposo", "full", "piena"], "axes": { "weight": 0.35, "brightness": -0.1 } },
